# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
.uv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Company data — never commit
packages/core/company/
!packages/core/company/.gitkeep
# config.py resolves company data against the directory holding `.env`, and the
# documented setup (`cp .env.example .env`) puts that at the repo root — so the
# profile, uploaded documents and client slots land HERE, not under
# packages/core. Ignoring only the path above left them committable.
#
# Unanchored on purpose, like `chroma_db/` below: the location follows whichever
# directory holds `.env`, falling back to the cwd, so it is not a two-place
# problem. `evals/run_evals.py` defaults COMPANY_PROFILE_PATH to
# ./company/profile.yaml and is documented as run from `evals/`, which anchoring
# to the root would leave exposed.
company/

# Vector store
*.chroma/
chroma_db/

# OER cache (downloaded by `openexecutive ingest-oer`)
packages/core/openexecutive/knowledge/external/

# Environment
.env
.env.local
.env.*.local

# Local Google Workspace OAuth credential minted by scripts/mint-google-token.py
# (the live refresh token — never commit)
.gworkspace-credentials/

# Operator scripts that contain real secrets. The matching ``.example``
# file is tracked so collaborators know what variables exist. Real values
# come from the repo-root ``.env`` (also gitignored above).
scripts/fly-secrets.sh
scripts/secrets.*.sh

# Node
packages/ui/node_modules/
packages/ui/.next/
packages/ui/out/
packages/ui/.turbo/
packages/ui/tsconfig.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE — track only the shared editor config (tasks, extension picks, repo
# settings). Personal junk like launch.json profiles stays out.
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Obsidian vault config (personal notes workspace — not part of the project)
.obsidian/

# Eval results (generated, not committed)
evals/results/

# Anvil
~/.claude/anvil/
# `make docker-export` packages the company profile, every uploaded document,
# the client slots and the whole database into one archive. Ignored so the
# command that exists to protect that data cannot be the thing that commits it.
openexec-state.tar.gz
*.tar.gz

*.db
# SQLite writes these beside the database in WAL mode. They are ignored
# explicitly because `*.db` does not match them.
*.db-wal
*.db-shm
packages/ui/tsconfig.tsbuildinfo
