# syntax=docker/dockerfile:1.6
# Multi-stage build for the Next.js UI. Produces a small runtime image that
# runs `node server.js` from the standalone output (see next.config.ts).

FROM node:22-alpine AS deps
WORKDIR /app
COPY packages/ui/package.json packages/ui/package-lock.json* ./
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY packages/ui/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Run as non-root for defense in depth.
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001 -G nodejs

# Standalone output contains a minimal server.js plus the node_modules it
# actually needs. Static assets must be copied in separately. (No public/
# directory in this project — add a COPY for it here if one is introduced.)
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

# Health probe via node — the image's own runtime, and guaranteed present
# because it is the CMD. node:22-alpine ships no curl, and leaning on a busybox
# applet would be an assumption where `node` is a certainty.
#
# /signin is the one path that answers 200 in both auth modes: middleware.ts
# excludes it from the auth matcher, so with sign-in ON it renders rather than
# redirecting to itself, and with DISABLE_AUTH=true the middleware is a no-op.
# It draws on the root layout only, which makes no backend call — so the UI
# does not report unhealthy merely because the API is down.
#
# PORT is read rather than hardcoded so overriding the env var does not
# silently break the probe -- and parsed with parseInt exactly as
# next/dist/build/utils.js parses it for server.js's bind. Concatenating the
# raw string diverges from what the server actually did: "3000 " and "3000abc"
# both bind 3000 but throw ERR_INVALID_URL in the probe, and "3000@evil.example"
# binds 3000 while sending the probe to evil.example:80 every 30s. A UI serving
# perfectly would have been marked unhealthy, and killed by autoheal or Swarm.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD ["node", "-e", "require('http').get('http://127.0.0.1:'+(parseInt(process.env.PORT,10)||3000)+'/signin',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]

EXPOSE 3000
CMD ["node", "server.js"]
